node_modules/
tmp/
# vendor/ is committed on purpose: production deploys via git and the host has no
# composer, so dompdf (PDF engine) must travel with the repo.

.env
.env.*
!.env.example

# Environment-specific DB credentials: keep per-server, never in git.
# Copy config/database.example.php to config/database.php on each environment.
config/database.php

*.log
*.tmp
.DS_Store
Thumbs.db

# Anexo de cotizaciones: la carpeta y su protección SÍ viajan en git (así el
# deploy no depende de que PHP pueda crearlas). Las fotos, no: son por servidor.
uploads/cotizaciones/*
!uploads/cotizaciones/.gitkeep
