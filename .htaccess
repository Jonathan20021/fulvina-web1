DirectoryIndex index.php
# La carpeta real es fulvina-web1: con el nombre viejo el 404 nunca resolvía y
# el servidor devolvía su propia página en vez de la del sitio.
ErrorDocument 404 /fulvina-web1/404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # canonical host: send the staging subdomain straight to the public domain
  RewriteCond %{HTTP_HOST} ^(www\.)?schmedicos\.kyrosrd\.com$ [NC]
  RewriteRule ^ https://schmedicos.com%{REQUEST_URI} [R=301,L]

  # force HTTPS (skip when behind a proxy that already terminated TLS, and on
  # localhost: XAMPP solo tiene certificado autofirmado, así que forzar HTTPS
  # en desarrollo obliga a saltarse un aviso del navegador en cada arranque)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # index.php (any level) -> clean directory root
  RewriteCond %{THE_REQUEST} \s/+(.*?)index\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # any other "*.php" -> extensionless clean URL
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # serve "/route" from "/route.php" when the file exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "^(PRODUCT|DESIGN)\.md$">
  Require all denied
</FilesMatch>

<Files "schema.sql">
  Require all denied
</Files>
